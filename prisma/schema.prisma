// Simracing-Hub's League Manager — full domain schema
// Auth.js tables + League/Season/Round/Registration + Results/Scoring + Reporting

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Auth.js tables
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  firstName       String?
  lastName        String?
  iracingMemberId String? @unique
  role            Role    @default(DRIVER)
  isActive        Boolean @default(true)

  accounts Account[]
  sessions Session[]

  // Domain back-relations
  leaguesCreated        League[]                 @relation("LeagueCreatedBy")
  registrations         Registration[]
  approvedRegistrations Registration[]           @relation("RegistrationApprovedBy")
  csvImports            CsvImport[]
  incidentReports       IncidentReport[]
  incidentEvidence      IncidentReportEvidence[]
  incidentComments      IncidentReportComment[]
  incidentDecisions     IncidentDecision[]
  raceCenterComebacks   RaceCenter[]             @relation("RaceCenterComeback")
  driverOfTheDayWins    RoundDriverOfTheDay[]    @relation("DotdWinner")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  countryCode           String?
  casDiscordGuildMember Boolean  @default(false)

  /// Discord user ID (snowflake). For drivers who signed in via Discord this
  /// is also held in Account.providerAccountId; admins can pre-set it here on
  /// a pre-registered driver who has NOT logged in yet, so the RSVP bot can
  /// resolve their button clicks before their first website login.
  discordId String? @unique

  // Latest iRating / Safety Rating / license class snapshot pulled from
  // members-ng.iracing.com via the admin sync flow (Chrome MCP one-shot
  // for now — see scripts/lm_*). Per-category because GT3 drivers might
  // also race Formula and Oval in iRacing.
  iratingSportsCar       Int?
  iratingFormulaCar      Int?
  iratingOval            Int?
  safetyRatingSportsCar  Float?
  safetyRatingFormulaCar Float?
  safetyRatingOval       Float?
  /// "Rookie" / "Class D" / "Class C" / "Class B" / "Class A" / "Pro"
  licenseClassSportsCar  String?
  licenseClassFormulaCar String?
  licenseClassOval       String?
  /// When the iRating block above was last refreshed. Null = never.
  iracingLastSyncedAt    DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// League domain
// ==========================================

model League {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?

  createdById String
  createdBy   User   @relation("LeagueCreatedBy", fields: [createdById], references: [id])

  /// Archived leagues are hidden from all public pages (home, /leagues,
  /// /rosters, overlay API). Admin pages still show them; direct URLs keep
  /// working for history. Toggle on the admin league-edit page.
  isArchived Boolean @default(false)

  seasons Season[]

  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  discordRegistrationsWebhookUrl String?
  registrationNotifyEmails       String[] @default([])
  paypalUsername                 String?
  registrationFee                Int?
  registrationFeeCurrency        String?  @default("EUR")

  // Per-round RSVP (Accept/Decline/Tentative) Discord integration
  discordGuildId       String?
  discordRsvpChannelId String?
  /// Optional Discord role to @mention on the initial RSVP post.
  /// Reminders (48h / 12h) do NOT use this — they only ping silent drivers.
  discordRsvpRoleId    String?
  /// Optional hex color (e.g. "#EB459E") used as the Discord embed's
  /// side-bar color on RSVP posts. Defaults to orange when unset.
  discordEmbedColor    String?
  rsvpDaysBefore       Int      @default(7)
  rsvpMode             RsvpMode @default(FULL)
  rsvpCloseBeforeHours Int      @default(1) // Hours before race start when RSVP locks

  /// Per-league channel for Twitch stream announcement bot posts.
  discordStreamChannelId String?
  /// Default Twitch URL for the league. Each StreamAnnouncement can
  /// override this; if both are unset the embed has no Twitch link.
  twitchUrl              String?

  /// YouTube channel the league's races are streamed on — accepts a
  /// channel ID ("UC…") OR an @handle (e.g. "@cas-tech-performance7363").
  /// Used by the YouTube auto-match cron (src/lib/match-youtube.ts) to find
  /// the stream VOD for a completed round and link it on the round page.
  /// Null = auto-matching off for this league. Requires YOUTUBE_API_KEY.
  youtubeChannelId       String?

  /// Optional public Garage 61 team URL for the league. Rendered as a
  /// small "Garage 61 team →" link on league / season pages so members
  /// can jump straight to the shared setups + practice laps.
  garage61TeamUrl String?

  /// Discord channel for the automatic after-race results post. Null = the
  /// results-post feature is off for this league. See src/lib/notify-results.ts.
  discordResultsChannelId String?

  /// Discord channel for the daily new-member welcome post. Null = the
  /// welcome feature is off. See src/lib/notify-welcome.ts.
  discordWelcomeChannelId String?
  /// Optional custom welcome message. "{names}" is replaced with the new
  /// members' names; if absent the names are appended. Null = a default.
  discordWelcomeMessage   String?
  /// Watermark — only members who joined after this are welcomed. Set to
  /// "now" on first run so existing members are never bulk-welcomed.
  discordWelcomeAfter     DateTime?
}

model Season {
  id           String       @id @default(cuid())
  leagueId     String
  league       League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name         String
  year         Int
  status       SeasonStatus @default(DRAFT)
  startsOn     DateTime?
  endsOn       DateTime?
  isMulticlass Boolean      @default(false)
  proAmEnabled Boolean      @default(false)
  gdcEnabled   Boolean      @default(false)

  scoringSystemId String
  scoringSystem   ScoringSystem @relation(fields: [scoringSystemId], references: [id])

  teamScoringMode  TeamScoringMode @default(NONE)
  teamScoringBestN Int?
  /// Number of best rounds counted toward the team championship (drop-weeks).
  /// Null = count all rounds. iRLM calls this "Weeks counted".
  /// E.g. set to 9 to count the team's best 9 round contributions only.
  teamScoringWeeksCounted Int?
  /// When true, team-scoring per-driver round contribution uses raw
  /// position points only — no participation, no manual penalty deduction.
  /// Matches iRLM's "Combined → Bonus: None" + "Raw Results" config.
  teamScoringRawOnly      Boolean @default(false)
  irlmLeagueName   String?
  irlmSeasonId     Int?
  scheduleImageUrl String?

  carClasses    CarClass[]
  cars          Car[]
  teams         Team[]
  rounds        Round[]
  registrations Registration[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  registrationToken String?  @unique
  teamRegistration  Boolean  @default(false)
  maxDrivers        Int?
  /// Per-team driver cap (e.g. 3 for IEC: team leader + 2 teammates).
  /// Null = uncapped at the season level; the league-slug shim in
  /// src/lib/team-limit.ts still applies (currently GT3 WCT only).
  teamMaxDrivers    Int?
}

model CarClass {
  id           String @id @default(cuid())
  seasonId     String
  season       Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name         String
  shortCode    String
  displayOrder Int    @default(0)

  cars               Car[]
  registrations      Registration[]
  fprAwards          FPRAward[]
  teamResults        TeamResult[]
  iracingCarClassId  Int?
  iracingCarClassIds Int[]          @default([])
  isLocked           Boolean        @default(false)

  @@unique([seasonId, shortCode])
}

model Team {
  id        String  @id @default(cuid())
  seasonId  String
  season    Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name      String
  shortName String?
  logoUrl   String?

  registrations Registration[]
  teamResults   TeamResult[]
  fprAwards     FPRAward[]
  iracingTeamId Int?           @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  leaderUserId  String?
  // Non-driving team manager (one per team). Has Manage Team rights like the
  // leader, never counts against the driver cap, never appears in driver
  // rosters. Set when someone registers the team as "Teammanager".
  managerUserId String?

  @@unique([seasonId, name])
}

model Round {
  id                    String      @id @default(cuid())
  seasonId              String
  season                Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  roundNumber           Int
  name                  String
  track                 String
  trackConfig           String?
  startsAt              DateTime
  countsForChampionship Boolean     @default(true)
  raceLengthMinutes     Int?
  status                RoundStatus @default(UPCOMING)
  irlmEventId           Int?

  raceResults         RaceResult[]
  csvImports          CsvImport[]
  incidentReports     IncidentReport[]
  fprAwards           FPRAward[]
  penalties           Penalty[]
  teamResults         TeamResult[]
  reportingNotifiedAt DateTime?

  // RSVP system
  rsvpNotifiedAt     DateTime?
  rsvpClosedAt       DateTime?
  rsvps              RoundRsvp[]
  rsvpDiscordMessage RoundDiscordRsvpMessage?
  fillIns            RoundFillIn[]

  /// Set when the after-race results were posted to Discord — idempotency
  /// flag for src/lib/notify-results.ts.
  resultsPostedAt DateTime?

  // Per-round Twitch stream announcement (1:1).
  streamAnnouncement StreamAnnouncement?

  // Per-round Race Center — narrative, curated cards, charts, replay (1:1).
  raceCenter RaceCenter?

  // Per-round Driver of the Day — recognition badge, no points (1:1).
  driverOfTheDay RoundDriverOfTheDay?

  /// YouTube video ID (11 chars) of the race-stream VOD for this round,
  /// embedded on the public round page. Set automatically by the YouTube
  /// auto-match cron (src/lib/match-youtube.ts) from League.youtubeChannelId,
  /// or pasted/cleared manually by an admin. A manual value is never
  /// overwritten by the cron (the cron only fills rounds where this is null).
  youtubeVideoId   String?
  /// When the video was linked (auto-match run or manual save). Doubles as
  /// the cron's idempotency marker.
  youtubeMatchedAt DateTime?

  @@unique([seasonId, roundNumber])
}

model Registration {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  status      RegistrationStatus @default(PENDING)
  startNumber String?

  teamId     String?
  team       Team?       @relation(fields: [teamId], references: [id])
  carClassId String?
  carClass   CarClass?   @relation(fields: [carClassId], references: [id])
  carId      String?
  car        Car?        @relation(fields: [carId], references: [id])
  proAmClass ProAmClass?
  inGdc      Boolean     @default(false)
  // True for a non-driving team manager registration (IEC "Teammanager"):
  // auto-approved, no car/iRating, excluded from rosters and driver caps.
  isTeamManager Boolean @default(false)

  notes        String?
  approvedById String?
  approvedBy   User?     @relation("RegistrationApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  raceResults         RaceResult[]
  reportedIncidents   IncidentReport[]               @relation("IncidentReporter")
  involvedInIncidents IncidentReportInvolvedDriver[]
  teamRoundDrivers    TeamRoundDriver[]
  penalties           Penalty[]
  rsvps               RoundRsvp[]
  fillIns             RoundFillIn[]

  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  excludedAt                DateTime?
  /// Set when an admin RETIRES this driver from the season. A retired driver
  /// keeps every RaceResult, so their championship points and finishing
  /// position stay exactly as-is (shown struck-through with a "Retired" badge),
  /// but they no longer count against the season's maxDrivers grid cap and are
  /// dropped from all forward-looking flows (RSVP embeds, one-race fill-ins,
  /// no-show penalties). Reversible: clearing this restores a confirmed seat
  /// (subject to the cap). Distinct from `excludedAt` (a DQ/removal marker).
  /// See src/lib/waitlist.ts (setRegistrationRetired) — retiring frees a seat
  /// and auto-promotes the next waiting-list driver.
  retiredAt                 DateTime?
  /// Set when this APPROVED registration is over the season's maxDrivers cap
  /// and therefore on the waiting list (not a confirmed grid driver). Waiting
  /// list order is by `createdAt` (registration date) ascending — first to
  /// register is first in line. Null = confirmed grid driver. See src/lib/waitlist.ts.
  waitlistedAt              DateTime?
  /// GT3 WCT only: admin-set "Startberechtigt Round 1" flag. A brand-new
  /// driver who raced neither last season nor the test race has no Pro/Am
  /// classification yet, so the admin decides whether they may take a race
  /// slot. Defaults to false (new registrations are NOT eligible until the
  /// admin checks the box); existing GT3 WCT registrations were backfilled to
  /// true. Gates the automatic waiting-list fill-in offer: a waitlisted GT3
  /// WCT driver is only DM'd a freed round slot when this is true
  /// (src/lib/waitlist.ts:reconcileFillInsForRound). Ignored for other leagues.
  eligibleRound1            Boolean          @default(false)
  startingFeePaid           AdminCheckStatus @default(NO)
  iracingInvitationSent     AdminCheckStatus @default(NO)
  iracingInvitationAccepted AdminCheckStatus @default(NO)
  iRating                   Int?

  @@unique([seasonId, userId])
}

model RaceResult {
  id             String       @id @default(cuid())
  roundId        String
  round          Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  finishPosition  Int
  classPosition   Int?
  lapsCompleted   Int          @default(0)
  raceDistancePct Int          @default(0)
  totalTimeMs     Int?
  bestLapTimeMs   Int?
  incidents       Int          @default(0)
  iRating         Int?
  finishStatus    FinishStatus @default(CLASSIFIED)

  rawPointsAwarded           Int     @default(0)
  participationPointsAwarded Int     @default(0)
  manualPenaltyPoints        Int     @default(0)
  manualPenaltyReason        String?
  notes                      String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  qualifyingTimeMs Int?
  startPosition    Int?
  raceNumber       Int      @default(1)
  correctionPoints Int      @default(0)
  carId            String?
  car              Car?     @relation(fields: [carId], references: [id])

  @@unique([roundId, registrationId, raceNumber])
}

model ScoringSystem {
  id                          String  @id @default(cuid())
  name                        String  @unique
  description                 String?
  pointsTable                 Json
  classPointsTable            Json?
  gdcPointsTable              Json?
  participationPoints         Int     @default(0)
  participationMinDistancePct Int     @default(75)
  racePointsMinDistancePct    Int     @default(50)
  bonusFastestLap             Int?
  bonusPole                   Int?
  bonusMostLapsLed            Int?
  dropWorstNRounds            Int?
  fprEnabled                  Boolean @default(false)
  fprTiers                    Json?
  fprMode                     FprMode @default(ALL_TEAMS_TIERED)

  seasons                 Season[]
  participationInCombined Boolean  @default(true)
  racesPerRound           Int      @default(1)
  pointsTableRace2        Json?
  protestWindowHours      Int?
  protestCooldownHours    Int?
  deferPenaltyPoints      Boolean  @default(false)
  categoryPointsTable     Json?
  driverFprEnabled        Boolean  @default(false)
  driverFprTiers          Json?
  driverFprMinDistancePct Int      @default(90)

  // Penalty-pool behaviour for the season(s) using this scoring system:
  //   OFF           — no penalty pool, no no-show penalties (default for most leagues)
  //   FULL          — GT3 WCT mode: all POINTS_DEDUCTION penalties feed the pool;
  //                   auto-forgiveness engine runs (every 2 clean rounds → -1 pool pt)
  //   NO_SHOW_ONLY  — SFL Cup mode: NO_RSVP_NO_SHOW penalties only appear in the
  //                   pool view; no auto-forgiveness; report-driven penalties still
  //                   hit standings directly but skip the pool view
  penaltyPoolMode           PenaltyPoolMode @default(OFF)
  // Points deducted for each no-show (when penaltyPoolMode is FULL or NO_SHOW_ONLY).
  noRsvpNoShowPenaltyPoints Int             @default(1)
}

model FPRAward {
  id                String    @id @default(cuid())
  roundId           String
  round             Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teamId            String
  team              Team      @relation(fields: [teamId], references: [id])
  carClassId        String?
  carClass          CarClass? @relation(fields: [carClassId], references: [id])
  teamIncidentTotal Int
  fprPointsAwarded  Int

  @@unique([roundId, teamId, carClassId])
}

model CsvImport {
  id               String @id @default(cuid())
  roundId          String
  round            Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  uploadedById     String
  uploadedBy       User   @relation(fields: [uploadedById], references: [id])
  originalFilename String
  rowsImported     Int    @default(0)
  rowsSkipped      Int    @default(0)
  errorLog         Json?

  createdAt DateTime @default(now())
}

// ==========================================
// Reporting system
// ==========================================

model IncidentReport {
  id                     String       @id @default(cuid())
  roundId                String
  round                  Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  reporterUserId         String
  reporterUser           User         @relation(fields: [reporterUserId], references: [id])
  reporterRegistrationId String
  reporterRegistration   Registration @relation("IncidentReporter", fields: [reporterRegistrationId], references: [id])

  lapNumber    Int?
  turnOrSector String?
  description  String
  status       IncidentStatus @default(SUBMITTED)
  submittedAt  DateTime       @default(now())

  involvedDrivers IncidentReportInvolvedDriver[]
  evidence        IncidentReportEvidence[]
  comments        IncidentReportComment[]
  decision        IncidentDecision?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  session             RaceSession?
  replayTimestamp     String?
  outsideRaceIncident Boolean      @default(false)
  irlmReviewId        Int?         @unique
  irlmProtestId       Int?         @unique
}

model IncidentReportInvolvedDriver {
  id               String          @id @default(cuid())
  incidentReportId String
  incidentReport   IncidentReport  @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)
  registrationId   String
  registration     Registration    @relation(fields: [registrationId], references: [id])
  role             ParticipantRole

  @@unique([incidentReportId, registrationId])
}

model IncidentReportEvidence {
  id               String         @id @default(cuid())
  incidentReportId String
  incidentReport   IncidentReport @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)
  kind             EvidenceKind
  content          String
  addedByUserId    String
  addedByUser      User           @relation(fields: [addedByUserId], references: [id])

  createdAt DateTime @default(now())
}

model IncidentReportComment {
  id               String         @id @default(cuid())
  incidentReportId String
  incidentReport   IncidentReport @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)
  authorUserId     String
  authorUser       User           @relation(fields: [authorUserId], references: [id])
  body             String
  isInternal       Boolean        @default(true)

  createdAt DateTime @default(now())
}

model IncidentDecision {
  id               String         @id @default(cuid())
  incidentReportId String         @unique
  incidentReport   IncidentReport @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)
  decidedByUserId  String
  decidedByUser    User           @relation(fields: [decidedByUserId], references: [id])
  decidedAt        DateTime       @default(now())
  verdict          Verdict
  publicSummary    String
  internalNotes    String?
  publishedAt      DateTime?

  penalties Penalty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Penalty {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  roundId        String
  round          Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)

  source                   PenaltySource
  sourceIncidentDecisionId String?
  sourceIncidentDecision   IncidentDecision? @relation(fields: [sourceIncidentDecisionId], references: [id])

  type               PenaltyType
  timePenaltySeconds Int?
  pointsValue        Int?
  gridPositions      Int?
  reason             String
  appliedAt          DateTime    @default(now())

  createdAt          DateTime         @default(now())
  category           PenaltyCategory?
  releasedAt         DateTime?
  forgivenPoints     Int              @default(0)
  autoForgivenPoints Int              @default(0)
  forgivenAt         DateTime?
  forgivenReason     String?
  categoryLevel      Int?
}

// ==========================================
// RSVP (per-round Discord registration)
// ==========================================

model RoundRsvp {
  id             String       @id @default(cuid())
  roundId        String
  round          Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  status RsvpStatus
  source RsvpSource @default(DISCORD)

  respondedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roundId, registrationId])
  @@index([roundId])
  @@index([registrationId])
}

/// A one-race fill-in: when a confirmed driver declines a round (RSVP) on a
/// capped season, the earliest-registered waiting-list driver is offered that
/// round's slot and DM'd. Created/revoked idempotently by
/// src/lib/waitlist.ts:reconcileFillInsForRound. Does NOT change the driver's
/// season waitlist status — it only covers this single round.
model RoundFillIn {
  id             String       @id @default(cuid())
  roundId        String
  round          Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  /// Optional: the confirmed driver whose decline freed this slot.
  replacesRegistrationId String?
  /// Set once the fill-in driver has been DM'd. Null = not yet notified (retry).
  notifiedAt             DateTime?
  /// Set when the fill-in driver clicks Accept on the offer DM. Null = not yet
  /// accepted (still pending the driver's response or already passed on/deleted).
  acceptedAt             DateTime?

  createdAt DateTime @default(now())

  @@unique([roundId, registrationId])
  @@index([roundId])
  @@index([registrationId])
}

model RoundDiscordRsvpMessage {
  id      String @id @default(cuid())
  roundId String @unique
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  channelId String
  messageId String
  postedAt  DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt
}

// ==========================================
// Twitch stream announcement (per round)
// ==========================================

model StreamAnnouncement {
  id      String @id @default(cuid())
  roundId String @unique
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  /// Vercel Blob URL of the uploaded poster image.
  posterBlobUrl    String?
  /// Per-round override of League.twitchUrl.
  twitchUrl        String?
  /// Optional custom body (markdown allowed).
  messageText      String?
  /// When the bot should post the announcement.
  scheduledAt      DateTime
  /// When the stream actually goes live (shown in the embed). Falls back
  /// to scheduledAt when null (legacy rows / not set).
  streamAt         DateTime?
  /// Set once the bot has posted. Used for idempotency.
  postedAt         DateTime?
  /// Snapshot of the channel + message so we can edit/delete later.
  discordChannelId String?
  discordMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// Enums
// ==========================================

enum Role {
  ADMIN
  STEWARD
  DRIVER
}

enum SeasonStatus {
  DRAFT
  OPEN_REGISTRATION
  ACTIVE
  PAUSED
  COMPLETED
}

enum RoundStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ProAmClass {
  PRO
  AM
}

enum FinishStatus {
  CLASSIFIED
  DNF
  DNS
  DSQ
}

enum TeamScoringMode {
  NONE
  SUM_ALL
  SUM_BEST_N
}

enum FprMode {
  LOWEST_TEAM_ONLY
  ALL_TEAMS_TIERED
}

enum IncidentStatus {
  SUBMITTED
  UNDER_REVIEW
  DECIDED
  DISMISSED
  WITHDRAWN
}

enum ParticipantRole {
  REPORTER
  ACCUSED
  WITNESS
}

enum EvidenceKind {
  YOUTUBE_LINK
  URL
  IRACING_REPLAY_REF
  IMAGE_URL
  TEXT
}

enum Verdict {
  NO_ACTION
  WARNING
  REPRIMAND
  TIME_PENALTY
  POINTS_DEDUCTION
  GRID_PENALTY_NEXT_ROUND
  SUSPENSION
}

enum PenaltySource {
  INCIDENT_DECISION
  ADMIN_MANUAL
  IRACECONTROL_IMPORT
  NO_RSVP_NO_SHOW
}

enum PenaltyPoolMode {
  OFF
  FULL
  NO_SHOW_ONLY
}

/// One refresh of the Discord community statistics (admin → Discord page).
/// `data` holds the whole computed snapshot as JSON — shape is DiscordStatsData
/// in src/lib/discord-stats.ts. Each refresh inserts a new row; the page reads
/// the most recent one.
model DiscordStatsSnapshot {
  id          String   @id @default(cuid())
  generatedAt DateTime @default(now())
  data        Json
}

/// Per-month Discord chat-activity buckets for the trend chart. One row per
/// calendar month (`month` = "YYYY-MM"). Past months are immutable once
/// scanned — the one-time backfill populates the history, the daily refresh
/// only re-writes the current month.
model DiscordMonthlyActivity {
  month         String   @id
  messageCount  Int      @default(0)
  activeMembers Int      @default(0)
  updatedAt     DateTime @updatedAt
}

enum RsvpStatus {
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum RsvpSource {
  DISCORD
  WEBSITE
  ADMIN // set by an admin on the round RSVP page, not by the driver
}

enum RsvpMode {
  FULL // Accept / Decline / Tentative buttons + all three driver lists
  DECLINE_ONLY // Only a Decline button; silent drivers are assumed racing
}

enum PenaltyType {
  TIME_PENALTY
  POINTS_DEDUCTION
  GRID_PENALTY
  WARNING
}

enum RaceSession {
  QUALIFYING
  RACE
  RACE_1
  RACE_2
}

enum PenaltyCategory {
  AVOIDABLE_CONTACT
  CAUSING_COLLISION
  BLOCKING
  TRACK_LIMITS
  JUMP_START
  IGNORING_BLUE_FLAGS
  UNSPORTSMANLIKE
  CHAT_MISCONDUCT
  OTHER
}

model TeamResult {
  id         String @id @default(cuid())
  roundId    String
  round      Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  raceNumber Int    @default(1)

  finishPosition  Int
  classPosition   Int?
  lapsCompleted   Int          @default(0)
  raceDistancePct Int          @default(0)
  totalTimeMs     Int?
  bestLapTimeMs   Int?
  totalIncidents  Int          @default(0)
  finishStatus    FinishStatus @default(CLASSIFIED)
  startPosition   Int?

  rawPointsAwarded           Int @default(0)
  participationPointsAwarded Int @default(0)
  manualPenaltyPoints        Int @default(0)
  correctionPoints           Int @default(0)

  carId      String?
  car        Car?      @relation(fields: [carId], references: [id])
  carClassId String?
  carClass   CarClass? @relation(fields: [carClassId], references: [id])

  participations TeamRoundDriver[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundId, teamId, raceNumber])
}

model TeamRoundDriver {
  id             String       @id @default(cuid())
  teamResultId   String
  teamResult     TeamResult   @relation(fields: [teamResultId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  lapsCompleted Int          @default(0)
  lapsLed       Int          @default(0)
  bestLapTimeMs Int?
  averageLapMs  Int?
  incidents     Int          @default(0)
  iRating       Int?
  finishStatus  FinishStatus @default(CLASSIFIED)

  @@unique([teamResultId, registrationId])
}

model Car {
  id String @id @default(cuid())

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  // Optional: a car pinned to a single class (legacy / class-specific).
  // When NULL the car is season-wide and selectable across all driver
  // classes — this is the common case for PRO/AM splits where both tiers
  // race the same cars.
  carClassId String?
  carClass   CarClass? @relation(fields: [carClassId], references: [id], onDelete: SetNull)

  name         String
  shortName    String?
  iracingCarId Int?
  displayOrder Int     @default(0)

  registrations Registration[]
  raceResults   RaceResult[]
  teamResults   TeamResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([carClassId, name])
  @@index([carClassId])
  @@index([seasonId])
}

enum AdminCheckStatus {
  PENDING
  YES
  NO
}

/// Cached snapshot of iRacing's track catalog (one row per track *variant* —
/// iRacing assigns a distinct track_id to each config). Populated by
/// /admin/iracing/tracks refresh button and the weekly cron job.
/// Used by the Add / Edit round form's TrackSelect typeahead.
model IracingTrack {
  iracingTrackId Int      @id
  trackName      String
  configName     String?
  category       String?
  freeContent    Boolean  @default(false)
  cachedAt       DateTime @default(now())

  @@index([trackName])
}

/// Cached snapshot of iRacing's car catalog (one row per car). Used as a
/// reference list for the Manage Cars admin page and for matching cars
/// at iRacing-JSON import time. Same lifecycle as IracingTrack: seeded
/// from src/data/iracing-cars.json + admin add/delete on
/// /admin/iracing/cars. iracingCarId values mirror iRacing's real car
/// IDs where known (confirmed from past imports); synthetic IDs ≥ 99001
/// are used for manually-added entries that don't have a known real ID.
model IracingCar {
  iracingCarId Int      @id
  name         String
  category     String? // GT3 / GT4 / LMP2 / GTP / Touring / Open Wheel / ...
  freeContent  Boolean  @default(false)
  cachedAt     DateTime @default(now())

  @@index([name])
}

/// Per-round "Race Center" — the curated post-race content that used to
/// live as static HTML on simracing-hub.com/race-center.html. Replaces
/// hand-mirroring CLS data into the website; this is the single source
/// of truth for narrative, curated cards, charts, and the 2D telemetry
/// replay video.
///
/// The public renderer lives on the existing round page at
/// /leagues/<slug>/seasons/<id>/rounds/<id>?cls=race-center — only
/// shown when publishedAt is set.
///
/// 1:1 with Round. All Vercel Blob URLs (replay, poster, charts) are
/// cleaned up via the deleteRaceCenter server action when the row is
/// removed; cascade deletes via Round cleanup are also covered.
model RaceCenter {
  id      String @id @default(cuid())
  roundId String @unique
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  /// Headline for the Race Center hero, e.g. "Zörlaut wins late,
  /// Wonnenberg's title secured". Distinct from Round.name (the track).
  headline     String?
  /// Multi-paragraph markdown rendered with react-markdown on the
  /// public Race Center tab. The narrative replaces what used to be
  /// written as <p>…</p> in race-center.html.
  highlightsMd String? @db.Text

  // === Curated By-the-Numbers cards =====================================
  // The Race Winner, Fastest Lap and Cleanest Race cards are AUTO-DERIVED
  // from raceResults on the public page — these *Note fields below are
  // optional commentary overlays. The Comeback Drive card is fully
  // curated: hidden when comebackUserId is null.

  /// Admin-selected driver for the "Comeback Drive" card. The card is
  /// HIDDEN on the public page when this is null.
  comebackUserId String?
  comebackUser   User?   @relation("RaceCenterComeback", fields: [comebackUserId], references: [id])
  comebackNote   String?
  /// Optional commentary on the auto-derived cleanest-race driver
  /// (the classified driver with the lowest Inc in raceResults).
  cleanestNote   String?
  /// Optional commentary on the auto-derived race winner (Pos = 1).
  winnerNote     String?
  /// Optional commentary on the auto-derived fastest-lap holder.
  fastestLapNote String?

  // === Conditions =======================================================
  // Most fields auto-pulled from iRacing JSON
  // (session_results[RACE].weather_result) via the "Pull from iRacing JSON"
  // admin button, with manual override.
  //
  // Track temp is NOT exposed in eventresult JSON, so it's the one field
  // the admin types by hand (read off the in-game replay).

  /// Average air temperature (°C). Auto-pulled from
  /// weather_result.avg_temp; admin can override.
  airTempC      Float?
  /// Track temperature (°C). Manual — iRacing eventresult JSON does
  /// not expose this directly.
  trackTempC    Float?
  /// iRacing skies code: 0 = clear, 1 = partly cloudy,
  /// 2 = mostly cloudy, 3 = overcast. Auto-pulled from
  /// weather_result.avg_skies. Display string is rendered client-side.
  skiesCode     Int?
  /// Average cloud cover %. Auto-pulled from
  /// weather_result.avg_cloud_cover_pct.
  cloudCoverPct Float?
  /// Total precipitation in mm during the race session.
  /// Auto-pulled from weather_result.precip_mm. 0 = bone dry.
  precipMm      Float?
  /// % of race time with active precipitation.
  /// Auto-pulled from weather_result.precip_time_pct.
  precipTimePct Float?

  // === Yellow flags =====================================================
  /// Number of FCY periods. Manually entered for v1; could be
  /// auto-derived from the incident timeline in Phase 2.
  yellowFlagCount Int     @default(0)
  yellowFlagNote  String?

  // === 2D telemetry replay ==============================================
  /// Vercel Blob URL of the MP4 telemetry replay.
  replayBlobUrl   String?
  /// Vercel Blob URL of the JPG poster shown above the video.
  posterBlobUrl   String?
  replayCaption   String?
  replayDurationS Int?

  // === Source / publishing ==============================================
  /// External broadcast (YouTube/Twitch) URL.
  broadcastUrl String?
  /// When the admin published the Race Center. Null = draft;
  /// public tab is hidden until this is set.
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charts RaceCenterChart[]

  @@index([publishedAt])
}

/// One row per chart image in a Race Center. Today we render up to 10
/// chart slots (gap, pace, pits, incidents, incidents-map, positions,
/// overtakes, pit-loss, stint-pace, battle), but chartType is left as
/// String so new kinds can be added without a schema migration. The
/// admin form's dropdown is driven by a TS const list in
/// src/lib/race-center-charts.ts.
///
/// Cascade-deletes with the parent RaceCenter; the deleteRaceCenter
/// server action additionally calls del() on each blobUrl so Vercel
/// Blob storage stays clean.
model RaceCenterChart {
  id           String     @id @default(cuid())
  raceCenterId String
  raceCenter   RaceCenter @relation(fields: [raceCenterId], references: [id], onDelete: Cascade)

  chartType String
  /// Display title for the card, e.g. "Gap to Leader".
  title     String
  /// Vercel Blob URL — PNG.
  blobUrl   String
  /// Optional descriptive paragraph below the chart.
  caption   String?
  /// Display order in the public "Data Views" grid.
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([raceCenterId, chartType])
}

/// Per-round "Driver of the Day" (1:1 with Round). A recognition badge ONLY —
/// it never awards championship points and never touches standings. Computed by
/// src/lib/driver-of-the-day.ts from an uploaded iRacing eventresult JSON
/// (authoritative start/finish/incidents + cust_id identity) blended with the
/// race-logger JSONL (overtakes counter + worst position reached for the
/// recovery metric). The winner is deliberately NOT the race winner by default:
/// a clean pole-to-flag win scores ~0 on positions-gained / recovery /
/// overtakes, so the charger who carved through the field wins instead.
model RoundDriverOfTheDay {
  id      String @id @default(cuid())
  roundId String @unique
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  /// Overall winner linked to a CLS user where the identity bridge resolved
  /// (eventresult cust_id -> User.iracingMemberId). Null when unmatched; the
  /// display name is always stored as a fallback.
  winnerUserId    String?
  winnerUser      User?   @relation("DotdWinner", fields: [winnerUserId], references: [id])
  winnerName      String
  winnerCarNumber String?

  /// Final weighted score (0..1).
  score Float
  /// Weighted component breakdown for the winner — each value is already
  /// multiplied by its weight: { positionsGained, recovery, overtakes, clean }.
  breakdown Json
  /// Raw winner metrics for display:
  /// { startPos, finishPos, worstPos, positionsGained, recovery, overtakes, incidents }.
  winnerMetrics Json

  /// Full field ranking (sorted by score desc) for the public "also
  /// outstanding" list and the admin review table. Array of row objects.
  ranking Json

  /// Per-car-class winners for multiclass seasons; [] for single-class.
  /// Array of { carClassShortName, winnerUserId?, winnerName, winnerCarNumber?,
  /// score, ranking? }.
  classWinners Json @default("[]")

  /// Weight profile used ("positions" default) + the resolved weights map.
  weightsProfile String @default("positions")
  weights        Json

  /// No-back-to-back rule context: the previous round's winner in this season
  /// is blocked from winning again (still ranked normally, just not crowned).
  previousWinnerUserId  String?
  previousWinnerName    String?
  previousWinnerBlocked Boolean @default(false)

  /// Archived raw uploads (Vercel Blob) so a round can be recomputed without
  /// re-uploading. Cleaned up on delete. `logBlobUrl` is race 1's log;
  /// `extraLogBlobUrls` holds the remaining race logs for two-race rounds.
  eventResultBlobUrl String?
  logBlobUrl         String?
  extraLogBlobUrls   String[] @default([])

  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


/// Saved endurance stint plan produced by the public /stint-planner tool.
/// Fully self-contained (no league/season FK) so it works for any iRacing
/// Special Event. `payload` holds the entire planner state as JSON:
/// { event, standard, saving, drivers[], assignments[] }.
model StintPlan {
  id        String   @id @default(cuid())
  /// Human title shown at the top of the plan (e.g. "6h Road America").
  title     String   @default("Stint Plan")
  /// Full planner state (inputs only — results are recomputed on load).
  payload   Json
  /// Secret token required to overwrite this plan; viewers without it can
  /// still open the read-only share link and "Save as new".
  editToken String
  /// Optional per-plan Garage 61 API token, AES-256-GCM encrypted at rest
  /// (see src/lib/crypto-secret.ts). Set only by the plan creator; NEVER
  /// returned to any client. When present, the live "Pull from Garage 61"
  /// uses it instead of the global GARAGE61_TOKEN fallback.
  garage61TokenEnc String?
  /// The Garage 61 team the plan pulls laps from (slug + display name),
  /// chosen by the creator when connecting the token.
  garage61TeamSlug String?
  garage61TeamName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
